# AgentHub 应用配置。复制为 .env 后再填写本机值，禁止提交真实凭据。
AGENTHUB_ENVIRONMENT=development
AGENTHUB_APP_NAME=AgentHub API
AGENTHUB_DATABASE_URL=YOUR_DATABASE_URL_HERE

# DeepSeek 单聊及子 Agent 共用（OpenAI 兼容接口）
AGENTHUB_LLM_BASE_URL=https://api.deepseek.com/v1
AGENTHUB_LLM_API_KEY=YOUR_API_KEY_HERE
AGENTHUB_LLM_MODEL=deepseek-chat

# Phase 8: BGE-M3 Embedding（硅基流动，OpenAI 兼容接口，1024 维）
# 注册 https://siliconflow.cn 获取 API Key，免费额度足够开发使用。
# 未配置时 RAG 知识库和会话记忆功能降级但不阻塞应用启动。
AGENTHUB_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AGENTHUB_EMBEDDING_API_KEY=YOUR_API_KEY_HERE
AGENTHUB_EMBEDDING_MODEL=BAAI/bge-m3

# 前端连接已注册项目所需的公开 UUID，不是凭据。
VITE_PROJECT_ID=00000000-0000-0000-0000-000000000001

# 仅供 infra/compose.yaml 的本地 PostgreSQL 开发容器使用。
AGENTHUB_POSTGRES_DB=agenthub
AGENTHUB_POSTGRES_USER=agenthub
AGENTHUB_POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD_HERE

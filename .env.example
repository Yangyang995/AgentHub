# AgentHub 应用配置。复制为 .env 后再填写本机值，禁止提交真实凭据。
AGENTHUB_ENVIRONMENT=development
AGENTHUB_APP_NAME=AgentHub API
AGENTHUB_DATABASE_URL=YOUR_DATABASE_URL_HERE
AGENTHUB_LLM_BASE_URL=https://YOUR_LLM_ENDPOINT_HERE/v1
AGENTHUB_LLM_API_KEY=YOUR_API_KEY_HERE
AGENTHUB_LLM_MODEL=YOUR_MODEL_NAME_HERE

# Phase 5 前端连接已注册项目和 Agent 所需的公开 UUID，不是凭据。
VITE_PROJECT_ID=00000000-0000-0000-0000-000000000001
VITE_AGENT_ID=00000000-0000-0000-0000-000000000002

# 仅供 infra/compose.yaml 的本地 PostgreSQL 开发容器使用。
AGENTHUB_POSTGRES_DB=agenthub
AGENTHUB_POSTGRES_USER=agenthub
AGENTHUB_POSTGRES_PASSWORD=YOUR_DATABASE_PASSWORD_HERE

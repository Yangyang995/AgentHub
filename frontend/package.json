{
  "name": "agenthub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "uv run --directory ../backend python scripts/export_frontend_contract.py ../frontend/src/api/generated/openapi.json && openapi-typescript src/api/generated/openapi.json -o src/api/generated/schema.ts",
    "prebuild": "npm run generate:api",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "npm run generate:api",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "lucide-react": "0.563.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.3.0",
    "jsdom": "28.1.0",
    "openapi-typescript": "7.13.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}

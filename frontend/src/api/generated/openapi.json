      "AdapterErrorCode": {
        "description": "平台无关的稳定错误码。\n\nAdapter 实现必须将具体平台错误映射为这些标准码，\n不得将凭据、隐私路径或完整 stderr 附加到错误消息中。",
        "enum": [
          "ADAPTER_TIMEOUT",
          "ADAPTER_CANCELLED",
          "ADAPTER_INTERNAL_ERROR",
          "ADAPTER_CONFIG_ERROR",
          "ADAPTER_UNAVAILABLE",
          "ADAPTER_INVALID_RESPONSE",
          "ADAPTER_EXECUTION_FAILED",
          "ADAPTER_PATH_REJECTED",
          "ADAPTER_PERMISSION_DENIED",
          "ADAPTER_UNKNOWN"
        ],
        "title": "AdapterErrorCode",
        "type": "string"
      },

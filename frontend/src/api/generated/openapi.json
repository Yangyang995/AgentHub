  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "检查 API 进程是否存活",
        "description": "只证明 FastAPI 事件循环可以响应，不探测外部依赖。",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "检查 Phase 1 应用是否就绪",
        "description": "确认类型化配置已加载。\n\n数据库和模型服务将在对应阶段接入；在此之前不得通过健康检查隐式连接它们。",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{project_id}/conversations": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Create Conversation",
        "description": "创建绑定一个已启用 Agent 的单聊会话。",
        "operationId": "create_conversation_api_v1_projects__project_id__conversations_post",
